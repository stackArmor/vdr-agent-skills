{
  "schema_version": 1,
  "benchmarks": {
    "gcp": "CIS Google Cloud Platform Foundation Benchmark v5.0.0",
    "aws": "CIS Amazon Web Services Foundations Benchmark v7.0.0",
    "azure": "CIS Microsoft Azure Foundations Benchmark v5.0.0"
  },
  "resources": [
    {"pattern": "^google_project$", "provider": "gcp", "category": "cloud-scope", "cis": ["GCP 1.1", "GCP 2"], "tag_surface": "labels", "scope_carrier": true, "rationale": "Project is the GCP policy, IAM, logging, and optional Class/multi-agency scope."},
    {"pattern": "^google_(folder|folder_organization_policy|org_policy_policy|project_organization_policy)$", "provider": "gcp", "category": "cloud-scope", "cis": ["GCP 1.1.3-1.1.4"], "tag_surface": "none", "rationale": "Folder and organization-policy assets are directly evaluated but lack ordinary labels."},
    {"pattern": "^google_(service_account|service_account_key|project_iam_custom_role|organization_iam_custom_role|apikeys_key)$", "provider": "gcp", "category": "identity", "cis": ["GCP 1.5-1.9", "GCP 1.13-1.16"], "tag_surface": "none", "rationale": "Identity, role, service-account key, and API-key assets are addressed by IAM recommendations."},
    {"pattern": "^google_(project|folder|organization|service_account)_iam_(policy|binding|member)$", "provider": "gcp", "category": "identity-assignment", "cis": ["GCP 1.6-1.12"], "tag_surface": "none", "rationale": "Retain only when a finding directly targets the IAM relationship."},
    {"pattern": "^google_kms_crypto_key$", "provider": "gcp", "category": "cryptography", "cis": ["GCP 1.10-1.12"], "tag_surface": "labels", "rationale": "Crypto key is the rotation, access, and separation-of-duties asset."},
    {"pattern": "^google_kms_(key_ring|crypto_key_version|.*_iam_(policy|binding|member))$", "provider": "gcp", "category": "cryptography", "cis": ["GCP 1.10-1.12"], "tag_surface": "none", "rationale": "Related KMS object; retain only if it is the finding target."},
    {"pattern": "^google_secret_manager_secret$", "provider": "gcp", "category": "secrets", "cis": ["GCP 1.18"], "tag_surface": "labels", "rationale": "Secret container is a first-class protected asset."},
    {"pattern": "^google_secret_manager_secret_(version|iam_(policy|binding|member))$", "provider": "gcp", "category": "secrets", "cis": ["GCP 1.18"], "tag_surface": "none", "rationale": "Secret child or access edge; retain only when directly evaluated."},
    {"pattern": "^google_logging_(project|folder|organization|billing_account)_(sink|bucket_config|exclusion)$", "provider": "gcp", "category": "logging", "cis": ["GCP 2.1-2.4"], "tag_surface": "none", "rationale": "Logging sink/bucket configuration is directly evaluated."},
    {"pattern": "^google_logging_metric$", "provider": "gcp", "category": "monitoring", "cis": ["GCP 2.5-2.12"], "tag_surface": "none", "rationale": "Log metric is part of a benchmark alerting control."},
    {"pattern": "^google_monitoring_alert_policy$", "provider": "gcp", "category": "monitoring", "cis": ["GCP 2.5-2.12"], "tag_surface": "user_labels", "rationale": "Alert policy is directly evaluated and supports user labels."},
    {"pattern": "^google_monitoring_notification_channel$", "provider": "gcp", "category": "monitoring", "cis": ["GCP 2.5-2.12"], "tag_surface": "labels", "rationale": "Notification channel is the alert destination asset."},
    {"pattern": "^google_compute_(instance|instance_from_template|instance_template|disk|region_disk|snapshot|image)$", "provider": "gcp", "category": "compute", "cis": ["GCP 4"], "tag_surface": "labels", "rationale": "VM, template, disk, snapshot, and image are primary compute assets."},
    {"pattern": "^google_compute_(instance_group_manager|region_instance_group_manager|instance_group)$", "provider": "gcp", "category": "compute", "cis": ["GCP 4"], "tag_surface": "none", "rationale": "Managed instance grouping is compute orchestration without ordinary labels."},
    {"pattern": "^google_(cloudfunctions_function|cloudfunctions2_function|cloud_run_v2_service|cloud_run_v2_job)$", "provider": "gcp", "category": "serverless-compute", "cis": ["GCP 1.18", "GCP 4"], "tag_surface": "labels", "rationale": "Function/Cloud Run workload is eligible when it is the affected compute or secret-exposure asset."},
    {"pattern": "^google_app_engine_(application|standard_app_version|flexible_app_version)$", "provider": "gcp", "category": "serverless-compute", "cis": ["GCP 4.10"], "tag_surface": "none", "rationale": "App Engine is directly addressed by HTTPS enforcement."},
    {"pattern": "^google_compute_(network|subnetwork|firewall|firewall_policy|network_firewall_policy|route|router|network_peering|vpn_gateway|ha_vpn_gateway|ssl_policy|region_ssl_policy|backend_service|region_backend_service)$", "provider": "gcp", "category": "network", "cis": ["GCP 2.8-2.10", "GCP 3"], "tag_surface": "none", "rationale": "Network policy and routing assets are directly evaluated but commonly lack labels."},
    {"pattern": "^google_compute_(address|global_address|forwarding_rule|global_forwarding_rule|external_vpn_gateway|vpn_tunnel)$", "provider": "gcp", "category": "network-edge", "cis": ["GCP 3.6-3.12", "GCP 2.17"], "tag_surface": "labels", "rationale": "Address, forwarding, and VPN edge resources support directly evaluated exposure paths."},
    {"pattern": "^google_(access_context_manager_service_perimeter|service_networking_connection|compute_service_attachment)$", "provider": "gcp", "category": "network-boundary", "cis": ["GCP 3.8-3.9"], "tag_surface": "none", "rationale": "Service perimeter and private service connectivity are benchmark boundary assets."},
    {"pattern": "^google_dns_managed_zone$", "provider": "gcp", "category": "dns", "cis": ["GCP 2.13", "GCP 3.3-3.5"], "tag_surface": "labels", "rationale": "Managed zone is the DNSSEC and DNS logging asset."},
    {"pattern": "^google_dns_policy$", "provider": "gcp", "category": "dns", "cis": ["GCP 2.13"], "tag_surface": "none", "rationale": "DNS policy directly controls logging for networks."},
    {"pattern": "^google_storage_bucket$", "provider": "gcp", "category": "object-storage", "cis": ["GCP 2.4", "GCP 5"], "tag_surface": "labels", "rationale": "Bucket is the storage access, retention, and classification asset."},
    {"pattern": "^google_sql_database_instance$", "provider": "gcp", "category": "database", "cis": ["GCP 6"], "tag_surface": "settings.user_labels", "rationale": "Cloud SQL instance is the database configuration and availability asset."},
    {"pattern": "^google_bigquery_(dataset|table)$", "provider": "gcp", "category": "analytics-data", "cis": ["GCP 7"], "tag_surface": "labels", "rationale": "Dataset/table is directly evaluated for access, CMEK, and classification."},
    {"pattern": "^google_dataproc_cluster$", "provider": "gcp", "category": "analytics-compute", "cis": ["GCP 8"], "tag_surface": "labels", "rationale": "Dataproc cluster is directly evaluated for CMEK."},

    {"pattern": "^aws_organizations_account$", "provider": "aws", "category": "cloud-scope", "cis": ["AWS 2.1-2.3"], "tag_surface": "tags", "scope_carrier": true, "rationale": "AWS account is directly evaluated and is an optional Class/multi-agency scope carrier."},
    {"pattern": "^aws_organizations_(organization|organizational_unit|policy|policy_attachment)$", "provider": "aws", "category": "cloud-scope", "cis": ["AWS 2.1"], "tag_surface": "verify", "rationale": "Organization, OU, and guardrail assets are directly evaluated but are not account scope carriers."},
    {"pattern": "^aws_iam_(user|group|role|policy|instance_profile|access_key|server_certificate|account_password_policy)$", "provider": "aws", "category": "identity", "cis": ["AWS 2.4-2.20"], "tag_surface": "verify", "rationale": "IAM principal, role, policy, credential, and certificate assets are directly evaluated."},
    {"pattern": "^aws_(iam_.*_(attachment|policy_attachment)|accessanalyzer_analyzer)$", "provider": "aws", "category": "identity-assignment", "cis": ["AWS 2.13-2.21"], "tag_surface": "verify", "rationale": "Retain assignments only for direct finding targets; Access Analyzer is a primary control asset."},
    {"pattern": "^aws_s3_bucket$", "provider": "aws", "category": "object-storage", "cis": ["AWS 3.1", "AWS 4.4", "AWS 4.8-4.9"], "tag_surface": "tags", "rationale": "S3 bucket is directly evaluated for access, deletion, classification, and logging."},
    {"pattern": "^aws_(db_instance|rds_cluster)$", "provider": "aws", "category": "database", "cis": ["AWS 3.2"], "tag_surface": "tags", "rationale": "RDS instance/cluster is the database encryption, exposure, patch, and availability asset."},
    {"pattern": "^aws_efs_file_system$", "provider": "aws", "category": "file-storage", "cis": ["AWS 3.3"], "tag_surface": "tags", "rationale": "EFS file system is directly evaluated for encryption."},
    {"pattern": "^aws_cloudtrail$", "provider": "aws", "category": "logging", "cis": ["AWS 4.1-4.5"], "tag_surface": "tags", "rationale": "CloudTrail trail is directly evaluated."},
    {"pattern": "^aws_config_configuration_recorder$", "provider": "aws", "category": "logging", "cis": ["AWS 4.3"], "tag_surface": "none", "rationale": "AWS Config recorder is directly evaluated and has no ordinary tags."},
    {"pattern": "^aws_kms_(key|replica_key)$", "provider": "aws", "category": "cryptography", "cis": ["AWS 4.5-4.6"], "tag_surface": "tags", "rationale": "Customer-managed KMS key is directly evaluated for encryption and rotation."},
    {"pattern": "^aws_(flow_log|cloudwatch_log_group|cloudwatch_log_metric_filter|cloudwatch_metric_alarm|sns_topic|securityhub_account)$", "provider": "aws", "category": "monitoring", "cis": ["AWS 4.7", "AWS 5"], "tag_surface": "verify", "rationale": "Logging, alerting, notification, and Security Hub assets implement benchmark monitoring."},
    {"pattern": "^aws_(instance|launch_template|ebs_volume|ami)$", "provider": "aws", "category": "compute", "cis": ["AWS 2.16", "AWS 6.1", "AWS 6.7"], "tag_surface": "tags", "rationale": "EC2 runtime, template, volume, and image are primary compute assets."},
    {"pattern": "^aws_(vpc|subnet|security_group|network_acl|route_table|vpc_peering_connection|vpc_endpoint)$", "provider": "aws", "category": "network", "cis": ["AWS 4.7", "AWS 6.2-6.8"], "tag_surface": "tags", "rationale": "VPC boundary, routing, and endpoint assets are directly evaluated."},
    {"pattern": "^aws_(lb|alb|cloudfront_distribution|apigatewayv2_api|api_gateway_rest_api)$", "provider": "aws", "category": "network-edge", "cis": ["AWS 4.10"], "tag_surface": "tags", "rationale": "Managed web front end is directly addressed by access logging."},

    {"pattern": "^azurerm_(subscription|management_group|resource_group|policy_(definition|assignment|set_definition)|management_lock)$", "provider": "azure", "category": "cloud-scope", "cis": ["Azure 5", "Azure 6.2"], "tag_surface": "verify", "rationale": "Subscription hierarchy, policy, and lock assets are directly evaluated."},
    {"pattern": "^azurerm_databricks_workspace$", "provider": "azure", "category": "analytics-compute", "cis": ["Azure 2.1"], "tag_surface": "tags", "rationale": "Databricks workspace is directly evaluated for identity, network, logging, and encryption."},
    {"pattern": "^azurerm_(linux|windows)_virtual_machine(_scale_set)?$", "provider": "azure", "category": "compute", "cis": ["Azure 3.1", "Azure 7.1-7.2"], "tag_surface": "tags", "rationale": "VM and scale set are primary compute assets."},
    {"pattern": "^azurerm_(managed_disk|image|snapshot)$", "provider": "azure", "category": "compute-storage", "cis": ["Azure 3"], "tag_surface": "tags", "rationale": "Disk/image/snapshot is part of the evaluated VM asset family."},
    {"pattern": "^(azuread_(user|group|application|service_principal|directory_role|conditional_access_policy)|azurerm_(user_assigned_identity|role_definition|role_assignment))$", "provider": "azure", "category": "identity", "cis": ["Azure 5"], "tag_surface": "verify", "rationale": "Entra identity, role, policy, managed identity, and assignment assets are directly evaluated."},
    {"pattern": "^azurerm_(mssql|postgresql|mysql|cosmosdb)_.*", "provider": "azure", "category": "database", "cis": ["Azure 4 (reference)", "Azure 8.1.7"], "tag_surface": "verify", "rationale": "Database service is referenced by Foundations and directly named by Defender database controls."},
    {"pattern": "^azurerm_(monitor_diagnostic_setting|log_analytics_workspace|monitor_activity_log_alert|application_insights)$", "provider": "azure", "category": "logging-monitoring", "cis": ["Azure 6.1"], "tag_surface": "verify", "rationale": "Diagnostic, logging, alerting, and telemetry assets are directly evaluated."},
    {"pattern": "^azurerm_(virtual_network|subnet|network_security_group|route_table|public_ip|virtual_network_gateway|private_endpoint|application_gateway|web_application_firewall_policy|bastion_host|network_ddos_protection_plan|network_watcher)$", "provider": "azure", "category": "network", "cis": ["Azure 7", "Azure 8.4-8.5"], "tag_surface": "verify", "rationale": "Network boundary, route, edge, inspection, bastion, and protection assets are directly evaluated."},
    {"pattern": "^azurerm_security_center_.*", "provider": "azure", "category": "security-posture", "cis": ["Azure 8.1-8.2"], "tag_surface": "verify", "rationale": "Defender plan and security-contact settings are directly evaluated."},
    {"pattern": "^azurerm_key_vault$", "provider": "azure", "category": "cryptography-secrets", "cis": ["Azure 6.1.1.4", "Azure 8.3"], "tag_surface": "tags", "rationale": "Key Vault is directly evaluated for logging, access, purge, network, and rotation controls."},
    {"pattern": "^azurerm_key_vault_(key|secret|certificate|managed_hardware_security_module)$", "provider": "azure", "category": "cryptography-secrets", "cis": ["Azure 8.3"], "tag_surface": "verify", "rationale": "Key, secret, certificate, and HSM assets are directly evaluated."},
    {"pattern": "^azurerm_storage_(account|share|container|blob)$", "provider": "azure", "category": "storage", "cis": ["Azure 9"], "tag_surface": "verify", "rationale": "Storage account, file share, and blob assets are directly evaluated."}
  ],
  "module_hints": [
    {"pattern": "(?=.*(?:gcp|google))(?:(^|/)(project|project-factory)(\\?|$)|(^|[-_])project($|[-_]))", "provider": "gcp", "category": "cloud-scope", "cis": ["GCP 1.1", "GCP 2"], "tag_surface": "module-review", "scope_carrier": true, "rationale": "Project module candidate; verify labels reach google_project."},
    {"pattern": "(?=.*(?:gcp|google))(?:compute-(vm|mig)|(^|[-_])vm($|[-_]))", "provider": "gcp", "category": "compute", "cis": ["GCP 4"], "tag_surface": "module-review", "rationale": "Compute module candidate; verify labels reach VM/template/disk assets."},
    {"pattern": "(?=.*(?:gcp|google))(?:(^|/)(gcs|storage-bucket)(\\?|$)|(^|[-_])bucket($|[-_]))", "provider": "gcp", "category": "object-storage", "cis": ["GCP 5"], "tag_surface": "module-review", "rationale": "Bucket module candidate; verify labels reach google_storage_bucket only."},
    {"pattern": "(?=.*(?:gcp|google))(?:cloudsql|cloud-sql)", "provider": "gcp", "category": "database", "cis": ["GCP 6"], "tag_surface": "module-review", "rationale": "Cloud SQL module candidate; verify labels reach settings.user_labels."},
    {"pattern": "(?=.*(?:gcp|google))(?:iam-service-account|service-account|(^|[-_])sa($|[-_]))", "provider": "gcp", "category": "identity", "cis": ["GCP 1.5-1.9"], "tag_surface": "module-review", "rationale": "Service-account module candidate; underlying principal is normally unlabelable."},
    {"pattern": "(?=.*(?:gcp|google))(?:(^|/)(kms)(\\?|$)|(^|[-_])kms($|[-_]))", "provider": "gcp", "category": "cryptography", "cis": ["GCP 1.10-1.12"], "tag_surface": "module-review", "rationale": "KMS module candidate; verify labels reach crypto keys rather than only child resources."},
    {"pattern": "(?=.*(?:gcp|google))(?:(^|/)(net-vpc|net-vpc-firewall|net-firewall-policy|vpc-sc|net-vpc-peering|net-lb)(\\?|$)|(^|[-_])(vpc|firewall|peering|lb)($|[-_]))", "provider": "gcp", "category": "network", "cis": ["GCP 2.17", "GCP 3"], "tag_surface": "module-review", "rationale": "Network module candidate; most underlying network resources are unlabelable."},
    {"pattern": "(?=.*(?:gcp|google))(?:(^|/)(dns)(\\?|$)|(^|[-_])dns($|[-_]))", "provider": "gcp", "category": "dns", "cis": ["GCP 2.13", "GCP 3.3-3.5"], "tag_surface": "module-review", "rationale": "DNS module candidate; verify labels reach the managed zone."},
    {"pattern": "(?=.*(?:gcp|google))(?:cloud-function|cloudrun|cloud-run)", "provider": "gcp", "category": "serverless-compute", "cis": ["GCP 1.18", "GCP 4"], "tag_surface": "module-review", "rationale": "Serverless module candidate; verify labels reach the workload."},

    {"pattern": "(?=.*aws)(?:organizations|organization|account|organizational-unit)", "provider": "aws", "category": "cloud-scope", "cis": ["AWS 2.1-2.3"], "tag_surface": "module-review", "scope_carrier": true, "rationale": "AWS account/organization module candidate; apply scope only to managed accounts."},
    {"pattern": "(?=.*aws)(?:^|[/_-])iam(?:$|[/_?-])", "provider": "aws", "category": "identity", "cis": ["AWS 2"], "tag_surface": "module-review", "rationale": "AWS IAM module candidate; verify which identities and policies support tags."},
    {"pattern": "(?=.*aws)(?:ec2-instance|launch-template|(^|[-_])ec2($|[-_]))", "provider": "aws", "category": "compute", "cis": ["AWS 2.16", "AWS 6.1", "AWS 6.7"], "tag_surface": "module-review", "rationale": "AWS EC2 module candidate; verify tags reach the primary compute assets."},
    {"pattern": "(?=.*aws)(?:s3-bucket|(^|[-_])s3($|[-_])|(^|[-_])bucket($|[-_]))", "provider": "aws", "category": "object-storage", "cis": ["AWS 3.1", "AWS 4.4", "AWS 4.8-4.9"], "tag_surface": "module-review", "rationale": "AWS S3 module candidate; verify tags reach the bucket rather than every child configuration."},
    {"pattern": "(?=.*aws)(?:^|[/_-])(rds|database)(?:$|[/_?-])", "provider": "aws", "category": "database", "cis": ["AWS 3.2"], "tag_surface": "module-review", "rationale": "AWS RDS module candidate; verify tags reach instances or clusters."},
    {"pattern": "(?=.*aws)(?:^|[/_-])efs(?:$|[/_?-])", "provider": "aws", "category": "file-storage", "cis": ["AWS 3.3"], "tag_surface": "module-review", "rationale": "AWS EFS module candidate; verify tags reach the file system."},
    {"pattern": "(?=.*aws)(?:^|[/_-])(vpc|network|security-group)(?:$|[/_?-])", "provider": "aws", "category": "network", "cis": ["AWS 4.7", "AWS 6"], "tag_surface": "module-review", "rationale": "AWS network module candidate; avoid tagging every supporting route attachment."},
    {"pattern": "(?=.*aws)(?:^|[/_-])kms(?:$|[/_?-])", "provider": "aws", "category": "cryptography", "cis": ["AWS 4.5-4.6"], "tag_surface": "module-review", "rationale": "AWS KMS module candidate; verify tags reach customer-managed keys."},
    {"pattern": "(?=.*aws)(?:cloudtrail|cloudwatch|securityhub|security-hub)", "provider": "aws", "category": "logging-monitoring", "cis": ["AWS 4-5"], "tag_surface": "module-review", "rationale": "AWS logging/monitoring module candidate; classify only primary finding targets."},
    {"pattern": "(?=.*aws)(?:^|[/_-])(alb|elb|cloudfront|api-gateway)(?:$|[/_?-])", "provider": "aws", "category": "network-edge", "cis": ["AWS 4.10"], "tag_surface": "module-review", "rationale": "AWS managed web-front-end module candidate; verify tags reach the front-end asset."},

    {"pattern": "(?=.*(?:azure|azurerm))(?:subscription|management-group|policy)", "provider": "azure", "category": "cloud-scope", "cis": ["Azure 5-6"], "tag_surface": "module-review", "rationale": "Azure scope/governance module candidate; verify the exact tag surface."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:azuread|entra|identity|service-principal|managed-identity)", "provider": "azure", "category": "identity", "cis": ["Azure 5"], "tag_surface": "module-review", "rationale": "Azure identity module candidate; many underlying identity objects are untaggable."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:virtual-machine|(^|[-_])vm($|[-_])|(^|[-_])compute($|[-_]))", "provider": "azure", "category": "compute", "cis": ["Azure 3"], "tag_surface": "module-review", "rationale": "Azure VM module candidate; verify tags reach VMs/scale sets and intentional disks."},
    {"pattern": "(?=.*(?:azure|azurerm))databricks", "provider": "azure", "category": "analytics-compute", "cis": ["Azure 2.1"], "tag_surface": "module-review", "rationale": "Azure Databricks workspace module candidate."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:storage-account|(^|[-_])storage($|[-_]))", "provider": "azure", "category": "storage", "cis": ["Azure 9"], "tag_surface": "module-review", "rationale": "Azure Storage module candidate; verify tags reach the account or directly evaluated child."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:key-vault|keyvault|managed-hsm)", "provider": "azure", "category": "cryptography-secrets", "cis": ["Azure 8.3"], "tag_surface": "module-review", "rationale": "Azure Key Vault/HSM module candidate; verify the exact native tag surfaces."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:mssql|postgresql|mysql|cosmosdb|(^|[-_])database($|[-_]))", "provider": "azure", "category": "database", "cis": ["Azure 4 (reference)", "Azure 8.1.7"], "tag_surface": "module-review", "rationale": "Azure database module candidate; retain the Foundations reference provenance."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:virtual-network|(^|[-_])vnet($|[-_])|application-gateway|private-endpoint|bastion|firewall)", "provider": "azure", "category": "network", "cis": ["Azure 7", "Azure 8.4-8.5"], "tag_surface": "module-review", "rationale": "Azure network module candidate; avoid propagating one tag to unrelated helpers."},
    {"pattern": "(?=.*(?:azure|azurerm))(?:monitor|log-analytics|application-insights|defender|security-center)", "provider": "azure", "category": "logging-security", "cis": ["Azure 6.1", "Azure 8.1"], "tag_surface": "module-review", "rationale": "Azure monitoring/Defender module candidate; classify primary assets only."}
  ]
}
